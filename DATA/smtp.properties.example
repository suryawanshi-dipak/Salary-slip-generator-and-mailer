# Copy to DATA/smtp.properties and fill in. The app reads that file at runtime;
# any missing key falls back to the code default (which is the localhost URL).

smtp.host=smtp.gmail.com
smtp.port=587
smtp.user=your-company-email@example.com
smtp.from=your-company-email@example.com

# ---- HRMS payroll-export API ------------------------------------------------
# Development: local HRMS backend
reimbursement.api.url=http://localhost:5000/api/reimbursements/payroll-export
loan.api.url=http://localhost:5000/api/loans/payroll-export
leave.api.url=http://localhost:5000/api/payroll-export/leaves
#
# Production: swap the host (no port)
#   reimbursement.api.url=http://161.118.171.230/api/reimbursements/payroll-export
#   loan.api.url=http://161.118.171.230/api/loans/payroll-export
#   leave.api.url=http://161.118.171.230/api/payroll-export/leaves

# Same service API key on both environments (create it in HRMS: Admin > API Keys,
# or INSERT into service_api_keys). Must exist in whichever DB the URL above points at.
reimbursement.api.key=your_service_api_key_here
loan.api.key=your_service_api_key_here
leave.api.key=your_service_api_key_here

# File paths (set via the Configuration button in the app)
masterctc.file.path=C:\\path\\to\\Master_CTC.csv
# Bank template .xls - leave blank to use the bundled DATA/ template
bankfile.template.path=
